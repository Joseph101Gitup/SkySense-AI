# ==============================================================================
# SKYsense AI — Environment Configuration Template
# ==============================================================================
# USAGE:
#   1. Copy this file to the project root and rename it to '.env':
#      cp .env.example .env         (Linux/macOS)
#      copy .env.example .env       (Windows)
#
#   2. Fill in ALL values marked "REQUIRED" before starting the server.
#
#   3. NEVER commit the active '.env' file to version control.
#      The .gitignore already excludes '.env' and '.env.*'.
#
#   4. For production, use your server/cloud provider's secret management
#      instead of a plain .env file wherever possible.
# ==============================================================================

# ==============================================================================
# DEVELOPMENT SETTINGS (default .env for local use)
# ==============================================================================

# --- Django Core Security ---
# REQUIRED: Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-at-least-50-chars-long

# Set to False in production to prevent debug info leaks
DJANGO_DEBUG=True

# Comma-separated list of valid hostnames this Django app will serve
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated trusted origins for CSRF POST requests
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- SSL / HTTPS (Development: keep False; Production: set to True) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Django Environment Context ---
# Set to "production" to activate hardened production mode.
# Leave empty (or "development") for local development.
DJANGO_ENV=development

# --- Database Configuration ---
# Development: Uses SQLite by default.
# Production (PostgreSQL): Provide the full connection URL:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# OR set discrete parameters below:
DATABASE_URL=

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0

# --- File Upload Constraints ---
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png

# --- AI Inference Model Paths ---
# Relative paths from the repository root. Adjust if model is located elsewhere.
AI_MODEL_WEIGHTS_PATH=03_AI_Model/models/best_xception_rainfall.keras
AI_TFLITE_PATH=03_AI_Model/models/xception_rainfall.tflite

# --- Logging ---
DJANGO_LOG_LEVEL=DEBUG

# ==============================================================================
# PRODUCTION SETTINGS (Reference — keep in your server's environment or vault)
# ==============================================================================
#
# DJANGO_SECRET_KEY=<cryptographically-random-50+-char-string>
# DJANGO_DEBUG=False
# DJANGO_ENV=production
# DJANGO_ALLOWED_HOSTS=skysense.ai,www.skysense.ai
# DJANGO_CSRF_TRUSTED_ORIGINS=https://skysense.ai,https://www.skysense.ai
#
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
#
# DATABASE_URL=postgres://skysense_user:STRONGPASSWORD@localhost:5432/skysense_db
# DB_CONN_MAX_AGE=600
#
# DJANGO_LOG_LEVEL=WARNING
